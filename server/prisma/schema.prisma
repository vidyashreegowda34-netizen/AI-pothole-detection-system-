// Prisma Schema for Namma Tumakuru Parishkara

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  phoneNumber    String         @unique
  name           String?
  role           String         @default("CITIZEN") // CITIZEN, OFFICER, ADMIN
  password       String?        // For Officer/Admin login
  departmentId   String?
  talukId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  department     Department?    @relation(fields: [departmentId], references: [id])
  taluk          Taluk?         @relation(fields: [talukId], references: [id])
  issues         Issue[]        @relation("ReportedIssues")
  assignedIssues Issue[]        @relation("AssignedOfficerIssues")
  upvotes        Upvote[]
  comments       Comment[]
  notifications  Notification[]
}

model Department {
  id          String     @id @default(uuid())
  code        String     @unique // TCC, PWD, BESCOM, KUWSDB, GRAM_PANCHAYAT, HEALTH, EDUCATION
  nameEn      String
  nameKn      String
  description String?
  officers    User[]
  issues      Issue[]
  categories  Category[]
}

model Taluk {
  id        String   @id @default(uuid())
  code      String   @unique
  nameEn    String
  nameKn    String
  latitude  Float
  longitude Float
  isUrban   Boolean  @default(false)
  wards     Ward[]
  issues    Issue[]
  users     User[]
}

model Ward {
  id         String   @id @default(uuid())
  talukId    String
  wardNumber Int
  nameEn     String
  nameKn     String
  taluk      Taluk    @relation(fields: [talukId], references: [id])
  issues     Issue[]
}

model Category {
  id           String     @id @default(uuid())
  code         String     @unique
  nameEn       String
  nameKn       String
  departmentId String
  slaHours     Int        @default(48)
  icon         String     @default("alert-circle")
  department   Department @relation(fields: [departmentId], references: [id])
  issues       Issue[]
}

model Issue {
  id               String          @id @default(uuid())
  trackingNumber   String          @unique // e.g. "TUM-2026-0001"
  title            String
  description      String
  status           String          @default("SUBMITTED") // SUBMITTED, VERIFIED, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED, REOPENED
  urgency          String          @default("MEDIUM")    // LOW, MEDIUM, HIGH, EMERGENCY
  
  // Geolocation
  latitude         Float
  longitude        Float
  addressText      String?
  talukId          String
  wardId           String?
  
  // Relations
  categoryId       String
  departmentId     String
  reporterId       String
  assignedToId     String?

  // Media
  photoUrls        String          // JSON serialized array of string paths: '["/uploads/img1.jpg"]'
  resolutionPhotos String?         // JSON serialized array of resolution proof paths
  resolutionNotes  String?
  
  // SLA and Timestamps
  slaDeadline      DateTime
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  taluk            Taluk           @relation(fields: [talukId], references: [id])
  ward             Ward?           @relation(fields: [wardId], references: [id])
  category         Category        @relation(fields: [categoryId], references: [id])
  department       Department      @relation(fields: [departmentId], references: [id])
  reporter         User            @relation("ReportedIssues", fields: [reporterId], references: [id])
  assignedOfficer  User?           @relation("AssignedOfficerIssues", fields: [assignedToId], references: [id])
  
  timeline         IssueTimeline[]
  upvotes          Upvote[]
  comments         Comment[]
  notifications    Notification[]
}

model IssueTimeline {
  id        String   @id @default(uuid())
  issueId   String
  status    String
  actionEn  String
  actionKn  String
  notes     String?
  actorName String?
  actorRole String   @default("CITIZEN")
  createdAt DateTime @default(now())
  
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Upvote {
  id        String   @id @default(uuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  issueId   String
  userId    String
  text      String
  isOfficer Boolean  @default(false)
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  issueId   String?
  titleEn   String
  titleKn   String
  messageEn String
  messageKn String
  isRead    Boolean  @default(false)
  channel   String   @default("IN_APP") // IN_APP, SMS_MOCK, WHATSAPP_MOCK
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
}
